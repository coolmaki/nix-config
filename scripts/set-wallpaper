#!/usr/bin/env bash
# Set wallpaper to wp<n>.jpg with fade transition
# Usage: set-wallpaper <n>
set -euo pipefail

WALLDIR="/home/maki/nixos-config/wallpapers"
N="${1:-1}"
IMAGE="${WALLDIR}/wp${N}.jpg"

if [ ! -f "$IMAGE" ]; then
    echo "Wallpaper not found: $IMAGE" >&2
    exit 1
fi

awww img "$IMAGE" --transition-type fade --transition-duration 0.5